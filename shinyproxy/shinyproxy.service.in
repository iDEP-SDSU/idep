# Reboot survival and crash recovery for the ShinyProxy stack.
#
# Without this, the nginx container comes back on its own (--restart
# unless-stopped) but the ShinyProxy JAR does not, so :443 answers 502 until
# someone runs ./idep.sh start by hand.
#
# This is a template: @USER@ and @DIR@ are filled in by `./idep.sh unit`
# with the user running it and the shinyproxy/ directory it lives in, so the
# unit follows the checkout instead of hardcoding a path. Install:
#   ./idep.sh unit | sudo tee /etc/systemd/system/shinyproxy.service >/dev/null
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shinyproxy
#
# Once installed, use `systemctl start|stop|restart shinyproxy`. While the
# unit is active, `./idep.sh start|stop|restart` refuses to run: a manual
# stop races systemd's restart, and a JVM that had to be SIGKILLed counts
# as a failure. `./idep.sh update` restarts through systemctl instead;
# status, check, parity, pin and logs work as before.
#
# ExecStart/ExecStop go through /bin/bash rather than executing idep.sh
# directly: with SELinux enforcing (RHEL), systemd may only execute files
# labeled as executables, and a checkout under /docker or $HOME is not
# (default_t / user_home_t) -- direct execution fails with 203/EXEC.
[Unit]
Description=ShinyProxy stack for iDEP and ShinyGO
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
# idep.sh start detaches the JVM and writes its pid; systemd then tracks
# that pid as the main process, which is what makes Restart= work.
Type=forking
PIDFile=@DIR@/shinyproxy.pid
User=@USER@
Group=docker
WorkingDirectory=@DIR@
ExecStart=/bin/bash @DIR@/idep.sh start
ExecStop=/bin/bash @DIR@/idep.sh stop

# Bring ShinyProxy back if it crashes or is OOM-killed. On restart idep.sh
# start sweeps the containers the dead instance left behind.
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

# 40+ R containers each allowed 15 GB on a host with no swap: if memory runs
# out, have the kernel kill one of them rather than the proxy that owns them.
OOMScoreAdjust=-900

# Pre-warming 60 containers takes well under a minute, but a cold page cache
# on the 9 GB database can make the first boot after a reboot much slower.
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
